// Emulator SAMO za snimke uputstva: dozvoljava sve prijavljenim korisnicima.
// (Prava pravila brenda nisu bitna za izgled ekrana; vidi `prod-read.cjs rules` ako treba provera.)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if request.auth != null; }
  }
}
