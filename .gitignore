# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# ─── White-label (brands) ────────────────────────────────────────────────────
# Kanonski izvori žive u brands/<brand>/ i JESU u gitu. Fajlovi ispod su
# GENERISANE kopije koje scripts/set-brand.js upisuje na native mesta pri
# svakom biranju brenda — ne smeju u git (inače bi zadnji buildovani brend
# zaprljao repo i doveo do mešanja).
/.active-brand
/capacitor.brand.json
/android/app/brand.properties
/android/app/google-services.json
/ios/App/GoogleService-Info.plist
/src/environments/environment.prod.ts

# Keystore-ovi (Android potpis) — NIKAD u git. Čuvaju se van repoa / u secret store.
/brands/*/release.keystore
*.keystore
*.jks

# Generisane native slike (ikone + splash) — potpuno izvedene iz brands/<brand>/assets/
# preko `capacitor-assets generate` i scripts/set-brand.js. Ne commituju se: menjaju
# se pri svakom biranju brenda i prljali bi git. Kanonski izvor je brands/<brand>/assets/.
# Ko klonira repo: pokrene `npm run set-brand -- <brand>` da ih regeneriše.
/android/app/src/main/res/drawable*/splash.png
/android/app/src/main/res/drawable*/splash_icon.png
/android/app/src/main/res/mipmap-*/ic_launcher*.png
/ios/App/App/Assets.xcassets/AppIcon.appiconset/*.png
/ios/App/App/Assets.xcassets/Splash.imageset/*.png
# resources/ je radna kopija brand assets-a (set-brand.js je prepisuje); PWA ikone
# generiše capacitor-assets. Oboje izvedeno iz brands/<brand>/assets/.
/resources/*.png
/src/assets/icons/icon-*.webp

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt


/.sourcemaps
/.versions
/coverage

# Ionic
/.ionic
/www
/platforms
/plugins

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*


# Miscellaneous
/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/test-results/

# System files
.DS_Store
Thumbs.db
